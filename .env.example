# ---- Servidor ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# IPs de proxies confiables (Express "trust proxy"), separadas por coma
TRUST_PROXY=loopback

# ---- SQL Server (principal) ----
DB_SERVER=
DB_PORT=1433
DB_NAME=
# Esquema de las tablas del portal: QA | Prod (crear/actualizar con: npm run migrate -- <esquema>)
DB_SCHEMA=QA
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# ---- Keycloak (auth) ----
# El backend intercambia el code por tokens con estas credenciales — el
# frontend nunca ve el client secret. Sin estos valores, /api/auth/keycloak-code
# responde 503 (fail-closed). El client debe tener "Client authentication: On"
# en Keycloak (confidencial) — el frontend nunca habla directo con Keycloak.
KEYCLOAK_ISSUER_URL=
KEYCLOAK_JWKS_URI=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Rol de Keycloak con todos los permisos (Configuración incluida). Los permisos
# de los demás roles se asignan en el portal: Configuración → Roles y permisos.
KEYCLOAK_ROLE_SUPERADMIN=Administrador

# JWT de sesión propio, emitido tras validar el login con Keycloak — generar
# con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Sin esto, todas las rutas protegidas responden 503 (fail-closed).
SESSION_JWT_SECRET=
SESSION_JWT_EXPIRES_IN=12h

# Solo para desarrollo local sin Keycloak levantado. NUNCA usar en producción.
AUTH_DISABLED=false

# ---- Evidencia (fotos) ----
# local | paperless (paperless aún no implementado, ver src/services/evidenceStorage)
EVIDENCE_STORAGE_PROVIDER=local
# Vacío = ./uploads/<DB_SCHEMA>/productos-danados (una carpeta por ambiente)
EVIDENCE_LOCAL_DIR=
EVIDENCE_MAX_SIZE_MB=5

# ---- Reclamos (faltante/sobrante/diferencias/daños) ----
# Vacío = ./uploads/<DB_SCHEMA>/reclamos (una carpeta por ambiente)
RECLAMOS_LOCAL_DIR=
# Catálogo compradora -> proveedor del portal FelixApproval (solo lectura, mismo servidor SQL)
RECLAMOS_COMPRADORAS_TABLA=FelixApproval.dbo.compradoras_proveedores
RECLAMOS_MAX_SIZE_MB=15
# true = permite crear sin documento SAP. Se IGNORA si NODE_ENV=production.
RECLAMOS_SAP_DOC_OPCIONAL=false

# ---- SAP / OracleDB (modo thin, sin cliente Oracle instalado) ----
# Solo lectura (SAPQRY): códigos de barra, descripción, precio y proveedor
# para Reclamos. La baja de inventario sigue pendiente (RFC/BAPI o staging).
# Se puede configurar con DB_SAP_* (host/puerto/SID por separado) o con
# SAP_ORACLE_* (tiene prioridad).
DB_SAP_HOST=
DB_SAP_PORT=1521
DB_SAP_SID=
DB_SAP_USER=
DB_SAP_PASS=
# SAP_ORACLE_USER=
# SAP_ORACLE_PASSWORD=
# Formato thin mode: host:puerto/service_name
# SAP_ORACLE_CONNECT_STRING=
SAP_ORACLE_TIMEOUT_MS=15000
# SAP_MANDANTE=600
# SAP_ESQUEMA=SAPSR3
# Baja de inventario de Productos Dañados en SAP (botón "Procesar"). false =
# la ruta responde 503 "La integración con SAP aún no está disponible.".
SAP_PROCESAR_HABILITADO=false

# ---- Correo saliente (envío del reporte al proveedor) ----
# Microsoft 365 con un buzón propio del portal (recomendado):
#   MAIL_HOST=smtp.office365.com  MAIL_PORT=587  MAIL_SECURE=false
#   MAIL_USER / MAIL_PASSWORD = el buzón (requiere SMTP AUTH habilitado por TI)
#   MAIL_FROM = ese mismo buzón
# Sin MAIL_HOST el botón "Enviar al proveedor" avisa que el correo no está configurado.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Felix Fix
# Alternativa: entregar el correo a un webhook de n8n que lo envía por Outlook
# (tiene prioridad sobre MAIL_HOST). Llega como multipart/form-data con los
# campos para, cc, responderA, asunto, html, texto, deNombre, adjuntos y los
# archivos adjunto0, adjunto1, … ; el token va en la cabecera X-Portal-Token.
# n8n acepta por defecto hasta 16 MB por petición (N8N_PAYLOAD_SIZE_MAX).
MAIL_N8N_WEBHOOK_URL=
MAIL_N8N_TOKEN=
# Nombre de la cabecera del token (el "Name" de la credencial Header Auth en n8n).
MAIL_N8N_HEADER=X-Portal-Token
MAIL_N8N_TIMEOUT_MS=60000
# Opcional: limitar destinatarios a estos dominios (coma). Vacío = cualquiera.
MAIL_SOLO_DOMINIOS=
# Total de adjuntos por correo (MB). Con n8n + Microsoft Graph (sendMail en una
# sola petición) el máximo real es ~2.8: Graph acepta 4 MB por petición y los
# adjuntos viajan en base64 (+33 %). Con SMTP puede ser mayor.
MAIL_MAX_ADJUNTOS_MB=2.8
# Avisos a cada área (Compradora, supervisor GOF, Gof, Contabilidad) cuando un
# reporte llega a su etapa. Van a los usuarios cuyos roles tienen el permiso de
# esa etapa en Configuración (el super administrador no los recibe).
MAIL_AVISOS=true
# Enlace del portal en los avisos. Vacío = el primer valor de CORS_ORIGIN.
PORTAL_URL=
