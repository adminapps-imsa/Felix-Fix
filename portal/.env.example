# El client es confidencial (Client authentication: On en Keycloak) — el
# secret vive solo en el .env del backend, nunca aquí. El frontend redirige
# al navegador a Keycloak y el backend hace el intercambio de código en
# POST /api/auth/keycloak-code. Requiere que el client tenga registrado
# <origen>/auth/callback como Valid Redirect URI.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Solo para desarrollo local, mientras no hay realm/client real de Keycloak.
# Combinar con AUTH_DISABLED=true en el .env del backend (si no, la API
# responde 503). NUNCA usar en producción.
VITE_AUTH_DISABLED=true
